\begin_layout Subsubsection
Formiranje elemenata grana i transformatora
\end_layout

\begin_layout Standard
Nakon što se iz mpc.branch sekcije pročitaju parametri grana (otpornost r,
 reaktansa x i šant susceptansa b),
 program pristupa izgradnji matrice admitanse sistema prema formulama navedenim u prethodnim poglavljima.
 
\end_layout

\begin_layout Standard
\begin_inset listings
lstparams "language={C++},frame=single,backgroundcolor={\color[gray]{0.95}}"
inline false
status open

\begin_layout Plain Layout
double r = row[2],
 x = row[3],
 b = row[4];
\end_layout

\begin_layout Plain Layout
double tap = row[8];
 double angDeg = row[9];
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
// Proračun serijske admitanse y = 1 / (r + jx)
\end_layout

\begin_layout Plain Layout
Cmplx y = (r == 0 && x == 0) ?
 Cmplx(0,0) :
 Cmplx(1.0) / Cmplx(r,
 x);
\end_layout

\begin_layout Plain Layout
Cmplx bsh(0.0,
 b / 2.0);
 // Polovina shunt susceptanse
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
// Korekcija za transformatore sa tapom i faznim pomakom
\end_layout

\begin_layout Plain Layout
double angRad = angDeg * M_PI / 180.0;
\end_layout

\begin_layout Plain Layout
Cmplx a(tap * std::cos(angRad),
 tap * std::sin(angRad));
 // tau = tap * e^(jphi)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
Cmplx dii_f = (y + bsh) / (a * std::conj(a));
  // Y_ii na "from" strani
\end_layout

\begin_layout Plain Layout
Cmplx dii_t =  y + bsh;
                         // Y_ii na "to" strani
\end_layout

\begin_layout Plain Layout
Cmplx dij   = -y / std::conj(a);
                // Y_ik element
\end_layout

\begin_layout Plain Layout
Cmplx dji   = -y / a;
                           // Y_ki element
\end_layout

\end_inset


\end_layout

