\begin_layout Standard
Kako bi se osigurale isključivo numeričke vrijednosti za dalji rad unutar dTwin modela,
 neophodno je sve izraze parsirati i konvertovati u slučaju da su izvorno dostupni u formi razlomaka,
 korijena i sličnih izraza.
 U tu svrhu,
 unutar klase Converter,
 u funkciji evalExpr() implementiran je evaluator izraza:
\end_layout

\begin_layout Standard
\begin_inset listings
lstparams "language={C++},breaklines=true,frame=single,backgroundcolor={\color[gray]{0.95}},basicstyle={\ttfamily\small}"
inline false
status open

\begin_layout Plain Layout
// Primjer provjere i parsiranja izraza iz koda
\end_layout

\begin_layout Plain Layout
static double evalExpr(const std::string& raw) {
\end_layout

\begin_layout Plain Layout
    char* end = nullptr;
\end_layout

\begin_layout Plain Layout
    double v = std::strtod(raw.c_str(),
 &end);
\end_layout

\begin_layout Plain Layout
    if (end && *end == '
\backslash
0') return v;
 // Ako je čist broj,
 vrati ga odmah
\end_layout

\begin_layout Plain Layout
    
\end_layout

\begin_layout Plain Layout
    // U suprotnom,
 aktivira se rekurzivni evaluator za složene izraze (npr.
 sa sqrt)
\end_layout

\begin_layout Plain Layout
    Eval e;
 e.p = raw.c_str();
\end_layout

\begin_layout Plain Layout
    return e.expr();
\end_layout

\begin_layout Plain Layout
}
\end_layout

\end_inset


\end_layout

