		<Res id="About"                 tr="About"/>
		<Res id="Quit"                  tr="Quit"/>

		<!-- Tab titles -->
		<Res id="TabInput"              tr="Input / Options"/>
		<Res id="TabProgress"           tr="Progress"/>
		<Res id="TabResults"            tr="Results"/>

		<!-- ViewInput -->
		<Res id="InputFileLabel"        tr="MATPOWER input file (.m):"/>
		<Res id="OutputFileLabel"       tr="Output file (.dmodl):"/>
